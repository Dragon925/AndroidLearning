<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_news"
    app:startDestination="@id/newsFragment">

    <fragment
        android:id="@+id/newsFragment"
        android:name="com.github.dragon925.androidlearning.news.ui.fragments.NewsFragment"
        android:label="NewsFragment" >
        <action
            android:id="@+id/action_newsFragment_to_filterFragment"
            app:destination="@id/filterFragment" />
        <action
            android:id="@+id/action_newsFragment_to_newsDetailsActivity"
            app:destination="@id/newsDetailsActivity" />
    </fragment>

    <fragment
        android:id="@+id/filterFragment"
        android:name="com.github.dragon925.androidlearning.news.ui.fragments.FilterFragment"
        android:label="FilterFragment" >
        <argument
            android:name="chosenFilters"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <activity
        android:id="@+id/newsDetailsActivity"
        android:name="com.github.dragon925.androidlearning.news.ui.activities.NewsDetailsActivity"
        android:label="NewsDetailsActivity" >
        <argument
            android:name="NewsDetailsID"
            app:argType="string" />
        <argument
            android:name="NewsDetailsTitle"
            app:argType="string" />
    </activity>
</navigation>