<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="0dp"
    app:cardBackgroundColor="@color/light_grey"
    android:layout_margin="@dimen/spacing_xxs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/spacing_s"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/category_image_width"
            android:layout_height="@dimen/category_image_height"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_placeholder"
            android:contentDescription="@string/help_category"/>

        <TextView
            style="@style/TextStyle"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:paddingHorizontal="@dimen/spacing_xl"
            tools:text="Дети"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>